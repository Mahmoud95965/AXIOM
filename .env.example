# ==============================================================================
# إعدادات الربط مع نموذج الذكاء الاصطناعي عبر Microsoft Azure
# ==============================================================================

# 1. نقطة الاتصال الخاصة بـ Azure (Endpoint URL)
# مثال: https://your-resource-name.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# 2. مفتاح واجهة برمجة التطبيقات (API Key)
AZURE_OPENAI_API_KEY=your_azure_api_key_here

# 3. اسم نشر النموذج في Azure (Deployment Name)
# مثال: gpt-4o أو gpt-4o-mini أو اسم الموديل الذي قمت بنشره
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# 4. إصدار واجهة Azure API (API Version)
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ==============================================================================
# خيارات إضافية لنماذج Azure AI Foundry / Azure ML (إذا كنت تستخدم Endpoint مباشر)
# ==============================================================================
AZURE_INFERENCE_ENDPOINT=
AZURE_INFERENCE_KEY=
